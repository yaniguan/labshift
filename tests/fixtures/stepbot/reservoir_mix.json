{
  "metadata": {
    "name": "Reservoir to plate mix",
    "description": "Fill a 24-well plate with water and dye from a 12-well reservoir and mix"
  },
  "steps": [
    {
      "comment": "Pre-fill row A with water"
    },
    {
      "distribute": {
        "pipette": "left",
        "src": "reservoir:A1",
        "dst": "plate:A1-A6",
        "volume": 250,
        "new_tip": "once"
      }
    },
    {
      "comment": "Spike dye into row A using p20 pipette"
    },
    {
      "transfer": {
        "pipette": "right",
        "src": "reservoir:A2",
        "dst": "plate:A1-A6",
        "volume": 15,
        "new_tip": "always"
      }
    },
    {
      "comment": "Mix each well in row A"
    },
    {
      "mix": {
        "pipette": "left",
        "wells": "plate:A1-A6",
        "volume": 150,
        "reps": 4,
        "new_tip": "always"
      }
    },
    {
      "pause": {
        "seconds": 3
      }
    }
  ]
}
