{
  "metadata": {
    "name": "Plate fill for absorbance read",
    "description": "Distribute buffer and add dye or water across row A for a plate read"
  },
  "steps": [
    {
      "comment": "Distribute buffer into row A wells A1-A8"
    },
    {
      "distribute": {
        "src": "reservoir:A1",
        "dst": "plate:A1-A8",
        "volume": 150,
        "new_tip": "once"
      }
    },
    {
      "comment": "Add dye to A1-A4 and water blanks to A5-A8"
    },
    {
      "transfer": {
        "src": "reservoir:A2",
        "dst": "plate:A1-A4",
        "volume": 50,
        "new_tip": "always"
      }
    },
    {
      "transfer": {
        "src": "reservoir:A3",
        "dst": "plate:A5-A8",
        "volume": 50,
        "new_tip": "once"
      }
    },
    {
      "mix": {
        "wells": "plate:A1-A8",
        "volume": 100,
        "reps": 3,
        "new_tip": "always"
      }
    },
    {
      "delay": {
        "seconds": 10
      }
    }
  ]
}
